{
  "name": "cubyz-hub",
  "version": "0.2.0",
  "description": "Local CubyzHub starter (Express + static frontend).",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/utils.test.js tests/api.test.js tests/uploads.test.js tests/dist.test.js",
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild public/auth.js public/dashboard.js public/profile.js public/load_addons.js public/addon_cards.js public/compress.js public/custom-select.js public/image-cropper.js public/changelog.js public/models.js public/uploadmodel.js public/servers.js public/server-detail.js --minify --outdir=public/dist",
    "build:css": "esbuild public/style.css public/ashframe-theme.css public/buttons.css --minify --outdir=public/dist",
    "build:creator-data": "node scripts/build-creator-data.js"
  },
  "author": "Ashframe",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "connect-sqlite3": "^0.9.15",
    "cors": "^2.8.5",
    "dompurify": "3.3.0",
    "dotenv": "^16.0.0",
    "express": "^4.22.1",
    "express-session": "^1.17.3",
    "marked": "^16.4.1",
    "multer": "^2.0.2",
    "sanitize-html": "^2.17.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "nodemon": "^3.1.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashframe-org/cubyz-hub.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/ashframe-org/cubyz-hub/issues"
  },
  "homepage": "https://github.com/ashframe-org/cubyz-hub#readme"
}
